@startuml
!theme plain

actor "Organismo\nAutorizado" as org
participant "API Gateway" as gateway
participant "Auth Service" as auth
participant "Alert Service" as alert
participant "Notification Service" as notif
participant "SQLite" as db
participant "Firebase" as firebase
participant "App Móvil" as mobile

org -> gateway : POST /api/send-notification/\n{title, body, type, coordinates}
activate gateway

gateway -> auth : validate_api_key(api_key)
activate auth
auth -> db : SELECT * FROM apikey WHERE key=?
db --> auth : ApiKey data
auth --> gateway : {valid: true, entidad: "Bomberos"}
deactivate auth

gateway -> alert : create_notification(data, api_key)
activate alert
alert -> alert : validate_emergency_data()
alert -> alert : auto_fill_source(api_key.entidad)
alert -> db : INSERT INTO notification
db --> alert : notification_id
alert --> gateway : {id: 123, status: "created"}
deactivate alert

gateway -> notif : send_alert(notification_id)
activate notif
notif -> firebase : add_document("alerts", data)
firebase --> notif : document_id
notif -> firebase : send_fcm_notification()
firebase -> mobile : Push Notification
notif --> gateway : {firebase_id, fcm_sent: true}
deactivate notif

gateway --> org : HTTP 201\n{id: 123, message: "Alert created"}
deactivate gateway

note right of alert
Auto-llena source desde
ApiKey.entidad para
trazabilidad
end note

note right of notif
Envío simultáneo a
Firestore y FCM para
máxima cobertura
end note

@enduml